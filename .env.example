# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase Postgres (via shared pooler on port 5432)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Supabase API (not used by the app, for reference only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared password that gates the Streamlit upload UI
APP_PASSWORD=
